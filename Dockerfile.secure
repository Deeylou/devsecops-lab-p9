# ✅ STAGE 1: Build stage
FROM python:3.12-alpine AS builder

# ✅ Set workdir sejak awal
WORKDIR /build

# ✅ Copy hanya requirements dulu (layer caching)
COPY requirements.txt .

# ✅ Install dependency, bersihkan cache dalam satu RUN
RUN pip install --no-cache-dir --user -r requirements.txt

# ✅ STAGE 2: Runtime stage - image final minimal
FROM python:3.12-alpine AS runtime

# ✅ Buat non-root user
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

# ✅ Set workdir
WORKDIR /app

# ✅ Copy dependency dari build stage saja
COPY --from=builder /root/.local /home/appuser/.local

# ✅ Copy hanya source code yang diperlukan
COPY --chown=appuser:appgroup app.py .

# ✅ Jalankan sebagai non-root user
USER appuser

# ✅ Expose port
EXPOSE 5000

# ✅ Gunakan gunicorn (production-grade server)
CMD ["/home/appuser/.local/bin/gunicorn", "--bind", "0.0.0.0:5000", "app:app"]
